          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0",
        "OTHER_SWIFT_FLAGS[config=Debug (MySwiftUIApp)]": "-DUSE_MYSWIFTUI_APP",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.pookjw.MyPlayground",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
