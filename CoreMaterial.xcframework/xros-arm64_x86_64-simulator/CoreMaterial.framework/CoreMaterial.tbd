                       _MTCoreMaterialRecipeKnowledgePlattersSheerDark,
                       _MTCoreMaterialRecipeKnowledgeBackground,
                       _MTCoreMaterialRecipeKnowledgeBackgroundDark,
                       _MTCoreMaterialRecipeCarPlayPlatters,
                       _MTCoreMaterialRecipeCarPlayPlattersDark,
                       _MTCoreMaterialRecipeDock,
                       _MTCoreMaterialRecipeDockDark,
                       _MTCoreMaterialRecipeToolbarButtonBackground,
                       _MTCoreMaterialRecipeAmbientCompact,
                       _MTCoreMaterialRecipePlatformChromeLight,
                       _MTCoreMaterialRecipePlatformChromeLightReduceTransparency,
                       _MTCoreMaterialRecipePlatformChromeDark,
