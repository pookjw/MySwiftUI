                       _MTCoreMaterialRecipePlatformContentGlass,
                       _MTCoreMaterialRecipePlatformContentGlassLighter,
                       _MTCoreMaterialRecipePlatformContentGlassDarker,
                       _MTCoreMaterialRecipePlatformContentGlassUltraDarker,
                       _MTCoreMaterialVisualStyleCategoryNone,
                       _MTCoreMaterialVisualStyleCategoryStroke,
                       _MTCoreMaterialVisualStyleCategoryFill,
                       _MTCoreMaterialVisualStyleCategoryPlatformColor,
                       _MTCoreMaterialVisualStyleCategoryOverlay,
                       _MTCoreMaterialVisualStyleNone,
