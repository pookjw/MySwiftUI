                       _MTCoreMaterialVisualStylePlatformTeal,
                       _MTCoreMaterialVisualStylePlatformOrange,
                       _MTCoreMaterialVisualStylePlatformGreen,
                       _MTVisualStylingCreateDictionaryRepresentation,
                       _kMTDictionaryRepresentationOptionsIncludeOptimizationsKey,
                       _kMTDictionaryRepresentationOptionsReduceTransparencyKey,
                       _kMTDictionaryRepresentationOptionsBundleKey ]
...
