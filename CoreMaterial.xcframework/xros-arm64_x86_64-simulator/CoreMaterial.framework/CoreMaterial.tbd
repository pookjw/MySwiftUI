--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-xros-simulator, arm64-xros-simulator ]
install-name:    '/System/Library/PrivateFrameworks/CoreMaterial.framework/CoreMaterial'
exports:
  - targets:         [ x86_64-xros-simulator, arm64-xros-simulator ]
