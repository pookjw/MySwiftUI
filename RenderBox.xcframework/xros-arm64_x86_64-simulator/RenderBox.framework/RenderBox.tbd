--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-xros-simulator, arm64-xros-simulator ]
install-name:    '/System/Library/PrivateFrameworks/RenderBox.framework/RenderBox'
swift-abi-version: 7
exports:
  - targets:         [ x86_64-xros-simulator, arm64-xros-simulator ]
    symbols:         [ _RBPathStorageInit,
    _RBPathRelease,
    _RBPathStorageAppendElement,
    _RBPathCGPathCallbacks,
    _RBPathIsEmpty,
    _RBPathEmpty,
    _RBPathMakeRect,
    _RBPathMakeEllipse,
    _RBPathMakeRoundedRect,
    _RBPathRetain,
    _RBPathStorageAppendPath,
    _RBPathStorageIsEmpty,
    _RBPathStorageDestroy,
    _RBPathApplyShape,
    _RBPathStorageIsSingleElement,
    _RBPathStorageApplyElements,
    _RBPathGetBoundingRect,
    _RBPathStorageGetBoundingRect,
    _RBPathCopyCGPath,
    _RBDisplayListGetState,
    _RBColorModeWorkingColorSpace,
    _RBDrawingStateTranslateCTM,
    _RBDrawingStateInit,
    _RBDrawingStateGetDefaultColorSpace,
    _RBDrawingStateGetDisplayList,
    _RBDrawingStateScaleCTM,
    _RBDrawingStateDrawShape,
    _RBDrawingStateClipShape,
    _RBDrawingStateBeginLayer,
    _RBDrawingStateDrawLayer,
    _RBDrawingStateDestroy,
    _RBColorFromLinear,
    _RBDrawingStateRotateCTM,
    _RBDrawingStateAddShadowStyle,
    _RBDrawingStateAddRotationStyle,
    _RBDrawingStateAddRotation3DStyle,
    _RBDrawingStateAddShadowStyle3,
    _RBDrawingStateAddPathProjectionStyle,
    _RBDrawingStateAddStyle,
    _RBDrawingStateAddColorMatrixFilter,
    _RBDrawingStateAddHueRotationFilter,
    _RBDrawingStateAddSaturationFilter,
    _RBDrawingStateAddBrightnessFilter,
    _RBDrawingStateAddContrastFilter,
    _RBDrawingStateAddColorInvertFilter,
    _RBDrawingStateAddGrayscaleFilter,
    _RBDrawingStateAddBlurFilter,
    _RBDrawingStateAddLuminanceCurveFilter,
    _RBDrawingStateAddRGBACurvesFilter,
    _RBDrawingStateAddLuminanceToAlphaFilter,
    _RBDrawingStateAddShaderFilter,
    _RBDrawingStateClipLayer,
    _RBDrawingStateConcatCTM,
    _RBDrawingStateGetClipBoundingBox,
    _RBDrawingStateGetCTM,
    _RBDrawingStateSetCTM,
    _RBDrawingStateBeginCGContext,
    _RBDrawingStateEndCGContext ]
    objc-classes:         [ RBDisplayList,
    RBShape,
    RBFill,
    RBDisplayListPredicate,
    RBDisplayListTransform,
    RBEncoderSet,
    RBShader,
    RBShaderLibrary,
    RBSymbolAnimator ]
    objc-ivars:           [  ]
...
