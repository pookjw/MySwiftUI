--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-xros, arm64e-xros ]
install-name:    '/System/Library/PrivateFrameworks/RenderBox.framework/RenderBox'
swift-abi-version: 7
exports:
  - targets:         [ arm64-xros, arm64e-xros ]
    symbols:         [ _RBPathStorageInit,
    _RBPathRelease,
    _RBPathStorageAppendElement,
    _RBPathCGPathCallbacks,
    _RBPathIsEmpty,
    _RBPathEmpty,
    _RBPathMakeRect,
    _RBPathMakeEllipse,
    _RBPathMakeRoundedRect,
    _RBPathRetain,
    _RBPathStorageAppendPath ]
    objc-classes:         [ RBDisplayList ]
    objc-ivars:           [  ]
...
