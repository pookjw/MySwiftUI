--- !tapi-tbd
tbd-version:     4
targets:         [ arm64-xros, arm64e-xros ]
install-name:    '/System/Library/PrivateFrameworks/RenderBox.framework/RenderBox'
swift-abi-version: 7
exports:
  - targets:         [ arm64-xros, arm64e-xros ]
    symbols:         [ _RBPathStorageInit,
    _RBPathRelease,
    _RBPathStorageAppendElement,
    _RBPathCGPathCallbacks,
    _RBPathIsEmpty,
    _RBPathEmpty,
    _RBPathMakeRect,
    _RBPathMakeEllipse,
    _RBPathMakeRoundedRect,
    _RBPathRetain,
    _RBPathStorageAppendPath,
    _RBPathStorageIsEmpty,
    _RBPathStorageDestroy,
    _RBPathApplyShape,
    _RBPathStorageIsSingleElement,
    _RBPathStorageApplyElements,
    _RBPathGetBoundingRect,
    _RBPathStorageGetBoundingRect,
    _RBPathCopyCGPath,
    _RBDisplayListGetState,
    _RBColorModeWorkingColorSpace,
    _RBDrawingStateTranslateCTM,
    _RBDrawingStateInit,
    _RBDrawingStateGetDefaultColorSpace,
    _RBDrawingStateGetDisplayList,
    _RBDrawingStateScaleCTM,
    _RBDrawingStateDrawShape,
    _RBDrawingStateClipShape,
    _RBDrawingStateBeginLayer,
    _RBDrawingStateDrawLayer,
    _RBDrawingStateDestroy,
    _RBColorFromLinear ]
    objc-classes:         [ RBDisplayList,
    RBShape,
    RBFill,
    RBDisplayListPredicate,
    RBDisplayListTransform,
    RBEncoderSet,
    RBShader,
    RBShaderLibrary ]
    objc-ivars:           [  ]
...
